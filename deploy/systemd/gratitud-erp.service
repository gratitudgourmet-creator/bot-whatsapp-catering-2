[Unit]
Description=Gratitud Gourmet ERP
After=network.target

[Service]
Type=simple
User=gratitud
Group=gratitud
WorkingDirectory=/opt/gratitud-erp
EnvironmentFile=/etc/gratitud-erp/gratitud-erp.env
ExecStart=/usr/bin/node /opt/gratitud-erp/whatsapp-catering-bot.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
