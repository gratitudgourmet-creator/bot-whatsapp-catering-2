[Unit]
Description=Gratitud Gourmet ZKTeco ADMS Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gratitud
Group=gratitud
WorkingDirectory=/opt/gratitud-erp
EnvironmentFile=/etc/gratitud-erp/gratitud-erp.env
ExecStart=/usr/bin/node /opt/gratitud-erp/zkteco-adms-receiver.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/gratitud-erp

[Install]
WantedBy=multi-user.target
