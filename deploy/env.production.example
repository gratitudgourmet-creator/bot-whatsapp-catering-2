# Gratitud Gourmet ERP - entorno de produccion
# Copiar este archivo en el servidor como:
# /etc/gratitud-erp/gratitud-erp.env

NODE_ENV=production

# El panel escucha solo dentro del servidor. Nginx publica HTTPS hacia afuera.
PORT=3080
PANEL_HOST=127.0.0.1

# En la web conviene arrancar primero solo el ERP/panel.
# El bot de WhatsApp queda para una segunda etapa o para correr localmente.
BOT_SKIP_WHATSAPP=1

# Carpeta persistente de base de datos JSON.
DATA_DIR=/var/lib/gratitud-erp/data
BOT_CONFIG_FILE=/var/lib/gratitud-erp/config-bot.json

# Seguridad del panel. Cambiar ambos valores antes de arrancar.
PANEL_AUTH_USER=admin
PANEL_AUTH_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
PANEL_SESSION_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_ALEATORIO

# Sheets no es base de datos. La sincronizacion automatica queda apagada por defecto.
PURCHASE_SHEETS_SYNC_ENABLED=false
ACCOUNTANT_SHEETS_SYNC_ENABLED=false

# Token opcional para importacion/sincronizacion manual con Google Sheets.
PURCHASE_SYNC_TOKEN=CAMBIAR_POR_OTRO_TOKEN_LARGO

# Integraciones opcionales.
PURCHASE_WEBHOOK_URL=
BUDGET_WEBHOOK_URL=
OPENAI_API_KEY=

# Limites y backups internos.
MAX_JSON_BODY_BYTES=15728640
JSON_BACKUPS=1
JSON_BACKUP_KEEP=30

# ZKTeco MB20-VL PUSH/ADMS. Mantener apagado hasta correr el receptor dentro de la LAN del reloj.
ZKTECO_ENABLED=false
ZKTECO_BIND_HOST=0.0.0.0
ZKTECO_PORT=8080
ZKTECO_ALLOWED_IPS=192.168.100.33
ZKTECO_ALLOWED_SERIALS=CO8G230760214
ZKTECO_TIMEZONE=America/Argentina/Buenos_Aires
ZKTECO_DEBOUNCE_SECONDS=180
ZKTECO_LOG_RAW_PAYLOADS=true
ZKTECO_MAX_BODY_BYTES=1048576
ZKTECO_BODY_TIMEOUT_MS=5000

# Sync seguro desde receptor local hacia ERP productivo. No expone /iclock/*.
ZKTECO_SYNC_ENABLED=false
ZKTECO_SYNC_TOKEN=
ZKTECO_SYNC_URL=
ZKTECO_SYNC_INTERVAL_SECONDS=30
ZKTECO_SYNC_BATCH_SIZE=100
ZKTECO_SYNC_REQUEST_TIMEOUT_MS=10000
